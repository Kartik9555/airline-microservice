<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="001" author="kartik9555">
        <createTable tableName="payment">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="booking_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="provider_payment_id" type="text"/>
            <column name="transaction_id" type="text"/>
            <column name="status" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="failure_reason" type="text"/>
            <column name="paid_at" type="timestamptz"/>
            <column name="refund_id" type="text"/>
            <column name="description" type="text"/>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
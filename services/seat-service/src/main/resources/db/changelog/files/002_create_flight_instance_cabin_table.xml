<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="002" author="kartik9555">
        <createSequence sequenceName="flight_instance_cabin_id_seq"/>
        <createTable tableName="flight_instance_cabin">
            <column name="id" type="bigint" autoIncrement="true" defaultValueSequenceNext="flight_instance_cabin_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flight_instance_id" type="bigint">
            </column>
            <column name="cabin_class_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_cabin_class" referencedTableName="cabin_class" referencedColumnNames="id"/>
            </column>
            <column name="total_seats" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="booked_seats" type="integer">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
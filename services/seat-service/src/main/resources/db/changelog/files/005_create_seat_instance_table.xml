<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="004" author="kartik9555">
        <createTable tableName="seat_instance">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flight_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="flight_instance_cabin_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_flight_instance_cabin" referencedTableName="flight_instance_cabin" referencedColumnNames="id"/>
            </column>
            <column name="flight_instance_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="seat_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_seat" referencedTableName="seat" referencedColumnNames="id"/>
            </column>
            <column name="status" type="text"/>
            <column name="is_booked" type="boolean" defaultValueBoolean="false"/>
            <column name="is_available" type="boolean" defaultValueBoolean="true"/>
            <column name="fare" type="numeric(12,2)"/>
            <column name="premium_surcharge" type="numeric(12,2)"/>
            <column name="flight_schedule_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
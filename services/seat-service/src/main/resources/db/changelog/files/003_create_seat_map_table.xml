<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="005" author="kartik9555">
        <createTable tableName="seat_map">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="total_rows" type="integer"/>
            <column name="right_seats_per_row" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="left_seats_per_row" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="airline_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="cabin_class_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_cabin_class" referencedTableName="cabin_class" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
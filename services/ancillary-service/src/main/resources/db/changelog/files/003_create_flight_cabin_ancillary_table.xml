<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="003" author="kartik9555">
        <createTable tableName="flight_cabin_ancillary">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flight_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="cabin_class_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="ancillary_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_ancillary_flight_cabin_ancillary" referencedTableName="ancillary" referencedColumnNames="id"/>
            </column>
            <column name="available" type="boolean"/>
            <column name="max_quantity" type="integer"/>
            <column name="price" type="numeric(12,2)"/>
            <column name="included_in_fare" type="boolean" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
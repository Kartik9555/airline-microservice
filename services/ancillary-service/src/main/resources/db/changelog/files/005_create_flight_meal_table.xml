<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="005" author="kartik9555">
        <createSequence sequenceName="flight_meal_id_seq"/>
        <createTable tableName="flight_meal">
            <column name="id" type="bigint" autoIncrement="true" defaultValueSequenceNext="flight_meal_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flight_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="meal_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_meal_flight_meal" referencedTableName="meal" referencedColumnNames="id"/>
            </column>
            <column name="available" type="boolean" defaultValueBoolean="true"/>
            <column name="price" type="numeric(12,2)"/>
            <column name="display_order" type="integer" defaultValue="0"/>
            <column name="notes" type="text"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
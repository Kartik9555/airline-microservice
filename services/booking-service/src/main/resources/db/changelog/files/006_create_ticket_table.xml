<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="006" author="kartik9555">
        <createSequence sequenceName="ticket_id_seq"/>
        <createTable tableName="ticket">
            <column name="id" type="bigint" autoIncrement="true" defaultValueSequenceNext="ticket_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ticket_number" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="issue_date" type="timestamp"/>
            <column name="passenger_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_passenger_tikcet" referencedTableName="passenger" referencedColumnNames="id"/>
            </column>
            <column name="booking_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_booking_ticket" referencedTableName="booking" referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="002" author="kartik9555">
        <createSequence sequenceName="aircraft_id_seq"/>
        <createTable tableName="aircraft">
            <column name="id" type="bigint" autoIncrement="true" defaultValueSequenceNext="aircraft_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="model" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="manufacturer" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="seating_capacity" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="economy_seats" type="integer"/>
            <column name="premium_economy_seats" type="integer"/>
            <column name="business_seats" type="integer"/>
            <column name="first_class_seats" type="integer"/>
            <column name="range_km" type="integer"/>
            <column name="cruising_speed_kmh" type="integer"/>
            <column name="max_altitude_ft" type="integer"/>
            <column name="year_of_manufacture" type="integer"/>
            <column name="registration_date" type="date"/>
            <column name="next_maintenance_date" type="date"/>
            <column name="status" type="varchar(20)"/>
            <column name="is_available" type="boolean" defaultValueBoolean="true"/>
            <column name="airline_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="current_airport_id" type="bigint"/>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
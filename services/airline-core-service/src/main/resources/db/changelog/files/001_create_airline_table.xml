<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="001" author="kartik9555">
        <createSequence sequenceName="airline_id_seq"/>
        <createTable tableName="airline">
            <column name="id" type="bigint" autoIncrement="true" defaultValueSequenceNext="airline_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="iata_code" type="text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="icao_code" type="text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="owner_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="alias" type="text"/>
            <column name="logo_url" type="text"/>
            <column name="website" type="text"/>
            <column name="status" type="text"/>
            <column name="alliance" type="text"/>
            <column name="headquarter_city_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="text"/>
            <column name="phone" type="text"/>
            <column name="hours" type="text"/>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
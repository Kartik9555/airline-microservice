<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="002" author="kartik9555">
        <createSequence sequenceName="flight_instance_id_seq"/>
        <createTable tableName="flight_instance">
            <column name="id" type="bigint" autoIncrement="true" defaultValueSequenceNext="flight_instance_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="airline_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="flight_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="departure_airport_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="arrival_airport_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="schedule_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="departure_date_time" type="timestamp"/>
            <column name="arrival_date_time" type="timestamp"/>
            <column name="total_seats" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="min_advance_booking_days" type="integer"/>
            <column name="max_advance_booking_days" type="integer"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true"/>
         </createTable>
    </changeSet>
</databaseChangeLog>
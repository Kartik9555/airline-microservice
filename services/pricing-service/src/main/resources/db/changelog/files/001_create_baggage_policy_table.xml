<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="001" author="kartik9555">
        <createSequence sequenceName="baggage_policy_id_seq"/>
        <createTable tableName="baggage_policy">
            <column name="id" type="bigint" autoIncrement="true" defaultValueSequenceNext="baggage_policy_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fare_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_fare_id" referencedTableName="fare" referencedColumnNames="id"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="cabin_baggage_max_weight" type="numeric(10,2)"/>
            <column name="cabin_baggage_pieces" type="integer"/>
            <column name="cabin_baggage_weight_per_piece" type="numeric(10,2)"/>
            <column name="cabin_baggage_max_dimension" type="integer"/>
            <column name="checkin_baggage_pieces" type="integer"/>
            <column name="checkin_baggage_weight_per_piece" type="numeric(10,2)"/>
            <column name="checkin_baggage_max_weight" type="numeric(10,2)"/>
            <column name="free_checked_bags_allowance" type="integer"/>
            <column name="priority_baggage" type="boolean" defaultValueBoolean="false"/>
            <column name="extra_baggage_allowance" type="boolean" defaultValueBoolean="false"/>
            <column name="airline_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>